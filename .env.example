# Local mode works without a DeepSeek key.
LLM_DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_NUM_CTX=32768
# Generation/interpreting in the local RAG chat; regular chat keeps its own budget.
# baseline | compact | optimized (8192 context, 1000 output, task-specific prompt)
RAG_LLM_PROFILE=optimized
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_DB_PATH=./data/chat.sqlite3
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# After scripts/prepare_local_rag.py these defaults are fully local.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
# DOCUMENT_INDEX_DIR=./data/document_index
# DOCUMENT_PDF_PATH=./data/documents/jcip-sample.pdf
# DOCUMENT_EMBEDDING_MODEL=./data/models/e5
# RAG_RERANKER_MODEL=./data/models/reranker
